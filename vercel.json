{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}
